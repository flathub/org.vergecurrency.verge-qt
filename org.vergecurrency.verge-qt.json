{
  "id": "org.vergecurrency.verge-qt",
  "runtime": "org.freedesktop.Platform",
  "sdk": "org.freedesktop.Sdk",
  "runtime-version": "25.08",
  "command": "verge-qt",
  "finish-args": [
    /* Xorg support */
    "--socket=x11",
    /* Sound */
    "--socket=pulseaudio",
    /* OpenGL access. */
    "--device=dri",
    /* IPC access. */
    "--share=ipc",
    /* Network acess. */
    "--share=network"
  ],
  "modules": [
    {
      "name": "verge",
      "buildsystem": "simple",
      "build-commands": [
        "chmod +x *.AppImage",
        "./Verge-Qt-x86_64.AppImage --appimage-extract",
        "mv squashfs-root verge-qt.AppDir",
        "./verged-x86_64.AppImage --appimage-extract",
        "mv squashfs-root verged.AppDir",
        "./verge-cli-x86_64.AppImage --appimage-extract",
        "mv squashfs-root verge-cli.AppDir",
        "./verge-tx-x86_64.AppImage --appimage-extract",
        "mv squashfs-root verge-tx.AppDir",
        "install -d /app/lib/verge",
        "cp -a verge-qt.AppDir verged.AppDir verge-cli.AppDir verge-tx.AppDir /app/lib/verge/"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": ["x86_64"],
          "url": "https://github.com/vergecurrency/verge/releases/download/v26.8/verge-ubuntu24-appimages.zip",
          "sha256": "41eac33ab81f99e6ab93977f4c93241f1ba2612c28006991599d65c12da2e9ee"
        }
      ]
    },
    {
      "name": "misc",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dp -m 644 org.vergecurrency.verge-qt.desktop /app/share/applications/org.vergecurrency.verge-qt.desktop",
        "install -Dp -m 644 verge.svg /app/share/icons/hicolor/scalable/apps/org.vergecurrency.verge-qt.svg",
        "install -Dp -m 644 org.vergecurrency.verge-qt.metainfo.xml /app/share/metainfo/org.vergecurrency.verge-qt.metainfo.xml",
        "bash install_wrappers.sh"
      ],
      "sources": [
        {
          "type": "file",
          "path": "org.vergecurrency.verge-qt.desktop"
        },
        {
          "type": "file",
          "path": "org.vergecurrency.verge-qt.metainfo.xml"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/vergecurrency/verge/master/src/qt/res/src/verge.svg",
          "sha256": "20465236bb8ccde4a5fd38ac7134c0462198ae4cfecdcdbb723e911873e0c652"
        },
        {
          "type": "file",
          "path": "install_wrappers.sh"
        }
      ]
    }
  ]
}
